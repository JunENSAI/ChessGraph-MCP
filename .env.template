# postgres config
POSTGRES_USER=user_name
POSTGRES_PASSWORD=user_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=db_name
POSTGRES_STATEMENT_TIMEOUT_MS=10000

# Chess.com account name for the data owner. Set the real value only in .env.
# The agent reads CHESS_USERNAME from the environment. Do not commit the account name.
CHESS_USERNAME=chess_username

# stockfish config to evaluate position
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=10

# MCP live-analysis defaults and hard bounds
STOCKFISH_DEFAULT_DEPTH=6
STOCKFISH_MAX_DEPTH=9
STOCKFISH_MAX_NODES=5000000
STOCKFISH_MAX_TIME_MS=30000
STOCKFISH_MAX_MULTIPV=5
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# neo4j config
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_PATH_DEPTH=4

# shared MCP bounds
MCP_MAX_RESULTS=100

# Hermes-Agent API. Fill in when the gateway is running. Do not commit a real key.
# HERMES_API_KEY must match API_SERVER_KEY in ~/.hermes/.env.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=

# Retrieval API for the UI. The Vite dev server proxies /api here.
BACKEND_URL=http://127.0.0.1:8000